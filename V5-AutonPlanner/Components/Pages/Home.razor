@page "/"
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">V5-AutonPlanner</a>
    </div>
</div>
<!-- layout: sidebar beside image grid -->
<div class="home-main">
  <div class="sidebar">

    <div class="sidebar-actions px-3 py-2">
      <button class="btn btn-primary" @onclick="Save">Save</button>
    </div>

    <!-- Compact instructions: click a grid cell to add a drive point or open the action menu -->
    <div class="action-buttons px-3 py-2">
      <div class="text-muted small">Click any cell on the field to add a drive point or to open a small action menu for inserting other actions.</div>
    </div>

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
                @foreach (var point in Actions)
                {

                    <a class="nav-link" href="#">
                        @GetActionString(point).GetAwaiter().GetResult()
                    </a>
                }
            </nav>
        </div>
    </div>
    <div class="grid-container" style="position:relative;">
    <img src="TopDown.png" alt="Top down view of the vex v5 override field">
    <div class="grid-overlay" data-cols="144" data-rows="144">
        @for (int x = 1; x <= 12 * 12; x++)
        {
            @for (int y = 1; y <= 12 * 12; y++)
            {
                var r = x;
                var c = y;
                // Highlight any cell that exists in movepoints
                var isHighlighted = HighlightList.Exists(mp => mp.x == r && mp.y == c);
                var index = HighlightList.FindIndex(mp => mp.x == r && mp.y == c);
                var displayIndex = index >= 0 ? index + 1 : -1;
                var classes = isHighlighted ? "grid-cell highlight" : "grid-cell";
                <div class="@classes" @onclick="@((e) => CellClicked(r, c))">
                    @if (displayIndex > 0)
                    {
                        <span class="dot-label">@displayIndex</span>
                    }
                </div>
            }
        }


    </div>
        <!-- SVG overlay for lines and numbered points -->
        <svg style="position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none;" viewBox="@($"0 0 {overlayImgWidth} {overlayImgHeight}")" preserveAspectRatio="none">
            @if (HighlightList != null && HighlightList.Count > 0)
            {
                // The overlay coordinates assume the image is not flipped.
                // Map Y directly: mappedY = y - 0.5 so points align with the image's top-to-bottom coordinates.
                var rows = 12 * 12;
                // Use pixel-accurate overlay computed by JS (image width/height and pixel points)
                var imgW = overlayImgWidth;
                var imgH = overlayImgHeight;
                if (!string.IsNullOrEmpty(PolylinePointsPx))
                {
                    <polyline points="@PolylinePointsPx" fill="none" stroke="#ff4d4f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                }

                @for (int i = 0; i < PixelPoints.Count; i++)
                {
                    var pp = PixelPoints[i];
                    <circle cx="@pp.x" cy="@pp.y" r="6" fill="#1890ff" />
                    <svg:text x="@pp.x" y="@(pp.y + 4)" font-size="12" fill="white" text-anchor="middle" alignment-baseline="middle">@((i + 1).ToString())</svg:text>
                }
            }
    </svg>

        @if (showCellMenu)
        {
            <div class="cell-menu" style="position:absolute; left:@(menuLeftPercent)% ; top:@(menuTopPercent)% ; transform:@(menuPlaceAbove ? "translate(-50%,-100%)" : "translate(-50%,0)"); background:rgba(0,0,0,0.75); color:white; padding:6px; border-radius:6px; z-index:30; pointer-events:auto;">
                <div class="d-flex flex-column">
                    <button class="btn btn-sm btn-primary mb-1" @onclick="MenuAddDrive">Drive here</button>
                    <button class="btn btn-sm btn-outline-light mb-1" @onclick="MenuOpenModalWait">Add Wait</button>
                    <button class="btn btn-sm btn-outline-light mb-1" @onclick="MenuOpenModalLift">Add Lift</button>
                    <button class="btn btn-sm btn-outline-light mb-1" @onclick="MenuOpenModalSetClaw">Set Claw</button>
                    <button class="btn btn-sm btn-outline-light mb-1" @onclick="MenuOpenModalClawFlip">Claw Flip</button>
                    <button class="btn btn-sm btn-outline-light mb-1" @onclick="MenuOpenModalRotate">Rotate</button>
                    <div class="d-flex">
                        <button class="btn btn-sm btn-success me-1" @onclick="MenuAddIntakeOn">Intake On</button>
                        <button class="btn btn-sm btn-danger" @onclick="MenuAddIntakeOff">Intake Off</button>
                    </div>
                    <button class="btn btn-sm btn-light mt-2" @onclick="CloseCellMenu">Cancel</button>
                </div>
            </div>
        }

    </div>
</div>

<!-- Modal for action arguments -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5 class="modal-title">Configure @modalActionType</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                @if (modalActionType == "Drive")
                {
                    <h6 class="modal-section-title">Movement Parameters</h6>
                    <div class="mb-3">
                        <label for="driveDistInput" class="form-label">Distance (inches)</label>
                        <input type="number" class="form-control" id="driveDistInput" @bind="driveDistance" />
                    </div>
                    <h6 class="modal-section-title">Speed Settings</h6>
                    <div class="mb-3">
                        <label for="driveSpeedInput" class="form-label">Speed (%)</label>
                        <input type="number" class="form-control" id="driveSpeedInput" @bind="driveSpeed" />
                    </div>
                }
                else if (modalActionType == "Wait")
                {
                    <h6 class="modal-section-title">Timing Parameters</h6>
                    <div class="mb-3">
                        <label for="waitDurationInput" class="form-label">Duration (milliseconds)</label>
                        <input type="number" class="form-control" id="waitDurationInput" @bind="waitDuration" />
                    </div>
                }
                else if (modalActionType == "Lift")
                {
                    <h6 class="modal-section-title">Lift Parameters</h6>
                    <div class="mb-3">
                        <label for="liftHeightInput" class="form-label">Height (deg)</label>
                        <input type="number" class="form-control" id="liftHeightInput" @bind="liftHeight" />
                    </div>
                }
                else if (modalActionType == "SetClaw")
                {
                    <h6 class="modal-section-title">Claw State</h6>
                    <div class="mb-3">
                        <label class="form-label">Set Claw to:</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="clawState" id="clawOn" value="true" @onchange="@((ChangeEventArgs e) => clawStateToggle = e.Value?.ToString() == "true")" />
                            <label class="btn btn-outline-primary" for="clawOn">On</label>

                            <input type="radio" class="btn-check" name="clawState" id="clawOff" value="false" @onchange="@((ChangeEventArgs e) => clawStateToggle = e.Value?.ToString() == "false")" />
                            <label class="btn btn-outline-primary" for="clawOff">Off</label>
                        </div>
                    </div>
                }
                else if (modalActionType == "ClawFlip")
                {
                    <h6 class="modal-section-title">Claw Flip State</h6>
                    <div class="mb-3">
                        <label class="form-label">Flip Claw to:</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="clawFlipState" id="clawFlipOn" value="true" @onchange="@((ChangeEventArgs e) => clawFlipStateToggle = e.Value?.ToString() == "true")" />
                            <label class="btn btn-outline-primary" for="clawFlipOn">On</label>

                            <input type="radio" class="btn-check" name="clawFlipState" id="clawFlipOff" value="false" @onchange="@((ChangeEventArgs e) => clawFlipStateToggle = e.Value?.ToString() == "false")" />
                            <label class="btn btn-outline-primary" for="clawFlipOff">Off</label>
                        </div>
                    </div>
                }
                else if (modalActionType == "Rotate")
                {
                    <h6 class="modal-section-title">Rotation Parameters</h6>
                    <div class="mb-3">
                        <label for="rotateDegreesInput" class="form-label">Degrees</label>
                        <input type="number" class="form-control" id="rotateDegreesInput" @bind="rotateDegrees" />
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ConfirmAction">Add Action</button>
            </div>
        </div>
    </div>
}
@inject IJSRuntime JS

@code {
    List<(int x, int y)> HighlightList = new();
    List<Action> Actions = new();

    // Pixel overlay data computed by JS
    private double overlayImgWidth = 144;
    private double overlayImgHeight = 144;
    private List<(double x, double y)> PixelPoints = new();
    private string PolylinePointsPx = string.Empty;
    private int lastHighlightCount = 0;

    // Modal state
    private bool showModal = false;
    private string modalActionType = "";

    // Inline cell menu state
    private bool showCellMenu = false;
    private double menuLeftPercent = 0;
    private double menuTopPercent = 0;
    private int menuGridX = 0;
    private int menuGridY = 0;
    private bool menuPlaceAbove = true;

    // Placeholder variables for action arguments (defined so buttons can reference them)
    private int driveDistance = 24; // inches
    private int driveSpeed = 50; // percent
    private int waitDuration = 1000; // milliseconds
    private int liftHeight = 10; // degrees
    private bool clawStateToggle = true; // for setclaw on/off
    private bool clawFlipStateToggle = true; // for clawflip on/off
    private int rotateDegrees = 180;

    private void OpenModal(string actionType)
    {
        modalActionType = actionType;
        showModal = true;
    }

    private void OpenModalWait()
    {
        OpenModal("Wait");
    }

    private void OpenModalLift()
    {
        OpenModal("Lift");
    }

    private void OpenModalSetClaw()
    {
        OpenModal("SetClaw");
    }

    private void OpenModalClawFlip()
    {
        OpenModal("ClawFlip");
    }

    private void OpenModalRotate()
    {
        OpenModal("Rotate");
    }

    private void CloseCellMenu()
    {
        showCellMenu = false;
    }

    private async Task MenuAddDrive()
    {
        // add drive point at menuGridX/menuGridY
        HighlightList.Add((menuGridX, menuGridY));
        var act = new Action();
        act.genralInt1 = menuGridX;
        act.y = menuGridY;
        act.type = 0;
        Actions.Add(act);
        showCellMenu = false;
        await UpdateOverlayAsync();
        StateHasChanged();
    }

    private void MenuAddIntakeOn()
    {
        AddIntakeOn();
        showCellMenu = false;
    }

    private void MenuAddIntakeOff()
    {
        AddIntakeOff();
        showCellMenu = false;
    }

    private void MenuOpenModalWait()
    {
        CloseCellMenu();
        OpenModalWait();
    }

    private void MenuOpenModalLift()
    {
        CloseCellMenu();
        OpenModalLift();
    }

    private void MenuOpenModalSetClaw()
    {
        CloseCellMenu();
        OpenModalSetClaw();
    }

    private void MenuOpenModalClawFlip()
    {
        CloseCellMenu();
        OpenModalClawFlip();
    }

    private void MenuOpenModalRotate()
    {
        CloseCellMenu();
        OpenModalRotate();
    }
    
    private void AddIntakeOn()
    {
        var act = new Action();
        act.type = 5;
        Actions.Add(act);
        StateHasChanged();
    }

    private void AddIntakeOff()
    {
        var act = new Action();
        act.type = 6;
        Actions.Add(act);
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private void ConfirmAction()
    {
        // Handle the action based on type
        var act = new Action();

        switch (modalActionType)
        {
            case "Drive":
                act.type = 0;
                act.genralInt1 = driveDistance;
                break;
            case "Wait":
                act.type = 2;
                act.genralInt1 = waitDuration;
                break;
            case "Lift":
                act.type = 4;
                act.genralInt1 = liftHeight;
                break;
            case "SetClaw":
                act.type = 3;
                act.clawState = clawStateToggle;
                break;
            case "ClawFlip":
                act.type = 8;
                act.clawState = clawFlipStateToggle;
                break;
            case "Rotate":
                act.type = 1;
                act.genralInt1 = rotateDegrees;
                break;
        }

        Actions.Add(act);
        CloseModal();
        StateHasChanged();
    }
    class Action
    {
        public int type = 0; // 0 = goto(int,int), 1 = rotate(int), 2 = wait(int), 3 = setclaw(bool), 4 = lift(int), 5 = intakeon(), 6 = intakeoff(), 7 = moveClawTo(int)
        public int genralInt1 = 0; // for goto, rotate, wait, lift, moveClawTo
        public int y = 0; // for goto
        public bool? clawState = null; // for setclaw
    }

    // Result returned from JS computePoints
    class OverlayResult
    {
        public double width { get; set; }
        public double height { get; set; }
        public double[][] points { get; set; }
    }

    // Result object for menu position from JS
    class MenuPosResult
    {
        public double leftPercent { get; set; }
        public double topPercent { get; set; }
        public bool placeAbove { get; set; }
    }
    async Task<string> GetActionString(Action action)
    {
        if (action.type == 0)
        {
            return $"goto({action.genralInt1}, {action.y})";
        }
        else if (action.type == 1)
        {
            return $"rotate({action.genralInt1})";
        }
        else if (action.type == 2)
        {
            return $"wait({action.genralInt1})";
        }
        else if (action.type == 3)
        {
            
            string clawState = action.clawState ?? false ? "true" : "false";
            return $"setclaw({clawState})";
        }
        else if (action.type == 4)
        {
            return $"lift({action.genralInt1})";
        }
        else if (action.type == 5)
        {
            return "intakeon()";
        }
        else if (action.type == 6)
        {
            return "intakeoff()";
        }
        else if (action.type == 7)
        {
            return $"moveClawTo({action.genralInt1})";
        }
        else if (action.type == 8)
        {
            string clawState = action.clawState ?? false ? "true" : "false";
            return $"clawflip({clawState})";
            //return $"({action})"
        }
        else
        {
            return "NULL";
        }
    }
    async Task CellClicked(int x, int y)
    {
        // Show the small inline menu at the clicked cell instead of immediately adding an action.
        var rows = 12 * 12;
        menuGridX = x;
        menuGridY = y;
        // compute percentages for positioning the menu centered on the cell using JS helper
        try
        {
            var pos = await JS.InvokeAsync<MenuPosResult>("gridOverlay.computeMenuPosition", x, y, null);
            if (pos != null)
            {
                menuLeftPercent = pos.leftPercent;
                menuTopPercent = pos.topPercent;
                menuPlaceAbove = pos.placeAbove;
            }
        }
        catch
        {
            // fallback to percent calculation (field = 144 inches)
            menuLeftPercent = ((x - 0.5) / 144.0) * 100.0;
            menuTopPercent = ((y - 0.5) / 144.0) * 100.0;
            menuPlaceAbove = true;
        }

        showCellMenu = true;
        await InvokeAsync(StateHasChanged);
    }

    // Note: OnAfterRenderAsync removed to avoid hot-reload override issues.
    // Overlay is updated when points are added (MenuAddDrive) or explicitly via UpdateOverlayAsync.

    private async Task UpdateOverlayAsync()
    {
        try
        {
            var pts = HighlightList.Select(p => new { x = p.x, y = p.y }).ToArray();
            var result = await JS.InvokeAsync<OverlayResult>("gridOverlay.computePoints", (object)pts, null);
            if (result != null)
            {
                overlayImgWidth = result.width;
                overlayImgHeight = result.height;
                PixelPoints = result.points.Select(a => (a[0], a[1])).ToList();
                PolylinePointsPx = string.Join(" ", PixelPoints.Select(p => $"{p.Item1},{p.Item2}"));
            }
        }
        catch
        {
            // ignore JS errors
        }
    }
    async Task Save()
    {
        // Save actions to a simple plain-text file.
        // The first drive/goto point will be written as STARTINGPOINT(x,y)
        // subsequent drive/goto points will be written as GOTO(x,y).
        var lines = new List<string>();
        bool startingPointWritten = false;

        foreach (var act in Actions)
        {
            if (act.type == 0)
            {
                // drive/goto action
                if (!startingPointWritten)
                {
                    lines.Add($"STARTINGPOINT({act.genralInt1},{act.y})");
                    startingPointWritten = true;
                }
                else
                {
                    lines.Add($"GOTO({act.genralInt1},{act.y})");
                }
            }
            else
            {
                // Non-drive actions are written using the display string produced by GetActionString
                lines.Add(await GetActionString(act));
            }
        }

        try
        {
            var fallback = System.IO.Path.Combine(AppContext.BaseDirectory, "config.txt");
            File.WriteAllLines(fallback, lines);
            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Save Your File",
                File = new ShareFile(fallback)
            });
        }
        catch (Exception)
        {
            // If writing fails (e.g. no F:), fall back to writing in the app folder so the user can inspect
            var fallback = System.IO.Path.Combine(AppContext.BaseDirectory, "config.txt");
            File.WriteAllLines(fallback, lines);
        }
    }
}