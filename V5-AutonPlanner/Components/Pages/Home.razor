@page "/"
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">V5-AutonPlanner</a>
    </div>
</div>
<!-- layout: sidebar beside image grid -->
<div class="home-main">
  <div class="sidebar">

    <div class="sidebar-actions px-3 py-2">
      <button class="btn btn-primary" @onclick="Save">Save</button>
    </div>

    <!-- Action buttons (bound to nothing) -->
    <div class="action-buttons px-3 py-2">
      <!-- Drive: needs distance (in), speed -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-distance="@driveDistance" data-speed="@driveSpeed">Add Drive</button>

      <!-- Turn: needs angle (deg), speed -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-angle="@turnAngle" data-speed="@turnSpeed">Add Turn</button>

      <!-- Wait: needs duration (ms) -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-duration="@waitDuration">Add Wait</button>

      <!-- Lift: needs height (units) -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-height="@liftHeight">Add Lift</button>

      <!-- Drop: needs none or optional target -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-target="@dropTarget">Add Drop</button>

      <!-- Rotate: needs degrees and speed -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-degrees="@rotateDegrees" data-speed="@rotateSpeed">Add Rotate</button>

      <!-- Sensor Wait: needs sensor name and threshold -->
      <button type="button" class="btn btn-outline-light mb-2" 
              data-sensor="@sensorName" data-threshold="@sensorThreshold">Add Sensor Wait</button>
    </div>

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
                @foreach (var point in Actions)
                {
                    
                    <a class="nav-link" href="#">
                        @GetActionString(point).GetAwaiter().GetResult()
                    </a>
                }
            </nav>
        </div>
    </div>
    <div class="grid-container">
    <img src="TopDown.png" alt="Top down view of the vex v5 override field">
    <div class="grid-overlay" data-cols="144" data-rows="144">
        @for (int x = 1; x <= 12 * 12; x++)
        {
            @for (int y = 1; y <= 12 * 12; y++)
            {
                var r = x;
                var c = y;
                // Highlight any cell that exists in movepoints
                var isHighlighted = HighlightList.Exists(mp => mp.x == r && mp.y == c);
                var index = HighlightList.FindIndex(mp => mp.x == r && mp.y == c);
                var displayIndex = index >= 0 ? index + 1 : -1;
                var classes = isHighlighted ? "grid-cell highlight" : "grid-cell";
                <div class="@classes" @onclick="@((e) => CellClicked(r, c))">
                    @if (displayIndex > 0)
                    {
                        <span class="dot-label">@displayIndex</span>
                    }
                </div>
            }
        }
    </div>
    </div>
</div>
@code {
    List<(int x, int y)> HighlightList = new();
    List<Action> Actions = new();
    // Placeholder variables for action arguments (defined so buttons can reference them)
    private int driveDistance = 24; // inches
    private int driveSpeed = 50; // percent
    private int turnAngle = 90; // degrees
    private int turnSpeed = 40; // percent
    private int waitDuration = 1000; // milliseconds
    private int liftHeight = 10; // arbitrary units
    private string dropTarget = "default";
    private int rotateDegrees = 180;
    private int rotateSpeed = 60;
    private string sensorName = "bumper";
    private int sensorThreshold = 1;
    class Action
    {
        public int type = 0; // 0 = goto(int,int), 1 = turn(int), 2 = wait(int), 3 = setclaw(bool), 4 = unused, 5 = intakeOn(), 6 = intakeOff(), 7 = moveClawTo(int)
        public int genralInt1 = 0; // for goto, turn, wait, moveClawTo
        public int y = 0; // for goto
        public bool? clawState = null; // for setclaw
    }
    async Task<string> GetActionString(Action action)
    {
        if (action.type == 0)
        {
            return $"goto({action.genralInt1}, {action.y})";
        }
        else if (action.type == 1)
        {
            return $"turn({action.genralInt1})";
        }
        else if (action.type == 2)
        {
            return $"wait({action.genralInt1})";
        }
        else if (action.type == 3)
        {
            return $"setclaw({action.clawState})";
        }
        else if (action.type == 5)
        {
            return "intakeOn()";
        }
        else if (action.type == 6)
        {
            return "intakeOff()";
        }
        else if (action.type == 7)
        {
            return $"moveClawTo({action.genralInt1})";
        }
        else
        {
            return "NULL";
        }
    }
    async Task CellClicked(int x, int y)
    {
        HighlightList.Add((x, y));
        var act = new Action();
        act.genralInt1 = x;
        act.y = y;
        act.type = 0;
        Actions.Add(act);
        await InvokeAsync(StateHasChanged);
    }
    async Task Save()
    {
        //json/other save logic to the SD card that the bot can read
        //i dont think json parsing is going to work with pros very well so im using the displaytype one instead
        string savestr = "";
        foreach (var act in Actions)
        {
            savestr += await GetActionString(act) + "\n";
        }
        int length = savestr.Split("\n").ElementAt(0).Length;
        File.WriteAllText(@"F:\config.txt",savestr);
    }
}