@page "/"
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">V5-AutonPlanner</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<!-- layout: sidebar beside image grid -->
<div class="home-main">
  <div class="sidebar">
    <NavMenu />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
            @foreach (var point in movepoints)
            {
                <a class="nav-link" href="#" @onclick="@(() => HighlightCell(point.Row, point.Column))">
                    Row: @point.Row, Column: @point.Column
                </a>
            }
            <div class="nav-item px-3">
            </div>
        </nav>
    </div>
  </div>

  <div class="grid-container">
  <!-- The background image -->
  <img src="TopDown.png" alt="Top down view of the vex v5 override field">
  
  <!-- The grid overlay -->
  <div class="grid-overlay">
    @for (int row = 1; row <= 12*12; row++)
    {
      @for (int col = 1; col <= 12*12; col++)
      {
        var r = row;
        var c = col;
        // Highlight any cell that exists in movepoints
        var isHighlighted = movepoints.Exists(mp => mp.Row == r && mp.Column == c);
        var classes = isHighlighted ? "grid-cell highlight" : "grid-cell";
        <div class="@classes" @onclick="@((e) => CellClicked(r, c))"></div>
      }
    }
  </div>
</div>

</div>
@code {
    private void CellClicked(int row, int column)
    {
        Console.WriteLine($"Grid cell clicked: Row {row}, Column {column}");
        // add the clicked cell to the move points list
        movepoints.Add((row, column));

        // highlight the clicked cell
        HighlightCell(row, column);
    }

    // The currently highlighted cell (1-based). -1 means none.
    private int highlightRow = -1;
    private int highlightColumn = -1;

    // List of move points as (row, column) tuples.
    private List<(int Row, int Column)> movepoints = new();

    // Highlight a specific cell (row, column) in blue.
    public void HighlightCell(int row, int column)
    {
        highlightRow = row;
        highlightColumn = column;
        StateHasChanged();
    }

    // Optional: clear the highlight
    public void ClearHighlight()
    {
        highlightRow = -1;
        highlightColumn = -1;
        StateHasChanged();
    }
}
